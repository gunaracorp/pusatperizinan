# PusatPerizinan.com — environment template for Hostinger Node.js.
# Never put real credentials in Git. Set real values in Hostinger Environment Variables.

# Prisma ORM 8 + PostgreSQL. Use the connection string from your PostgreSQL provider.
# Runtime requires DATABASE_URL. For providers with pooled and direct URLs,
# configure DATABASE_URL as the pooled URL and DIRECT_URL as the direct URL only if needed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required admin authentication
ADMIN_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"
ADMIN_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
CRON_SECRET="REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET"

# Payments
PAYMENT_DEMO_MODE="false"
BANK_TRANSFER_INFO=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
TRIPAY_IS_PRODUCTION="false"
# TRIPAY_METHODS="QRIS,BRIVA,BCAVA,BNIVA,MANDIRIVA,SHOPEEPAY,ALFAMART,INDOMARET"

# Optional notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
FONNTE_TOKEN=""

# Operational and analytics
FOLLOWUP_SWEEP_MINUTES="15"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_GA_ID="G-KMZRQJQXCB"
NEXT_PUBLIC_CLARITY_ID=""
# INDEXNOW_KEY=""
