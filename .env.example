# TEMPLATE ONLY — never place real credentials in Git.
# Copy the required values into Hostinger's Environment Variables panel.
# Current schema uses SQLite + Prisma 7. Do NOT paste a PostgreSQL URL here
# until the database adapter/schema migration has been completed and tested.

DATABASE_URL="file:./db/custom.db"

# Generate unique secrets before production; do not use the placeholders.
ADMIN_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"
ADMIN_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
CRON_SECRET="REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET"

# Keep demo payments disabled in production unless you intentionally want
# simulated payments. With no gateway keys, the app falls back to manual payment.
PAYMENT_DEMO_MODE="false"
BANK_TRANSFER_INFO=""

# Optional payment gateways (server-side secrets; never prefix with NEXT_PUBLIC_)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
TRIPAY_IS_PRODUCTION="false"
# Optional comma-separated method codes:
# TRIPAY_METHODS="QRIS,BRIVA,BCAVA,BNIVA,MANDIRIVA,SHOPEEPAY,ALFAMART,INDOMARET"

# Optional notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
FONNTE_TOKEN=""

# Optional operational settings
FOLLOWUP_SWEEP_MINUTES="15"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_GA_ID="G-KMZRQJQXCB"
NEXT_PUBLIC_CLARITY_ID=""
# INDEXNOW_KEY=""
