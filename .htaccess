# ============================================================
# PUSATPERIZINAN.COM — .htaccess untuk HOSTING STATIS
# Apache / LiteSpeed (idwebhost cPanel) — tanpa Node.js
# ============================================================
# Fungsi: index dokumen, halaman 404 branded, kompresi GZIP,
# cache browser (aset ber-hash = permanen, HTML = selalu segar),
# dan (opsional) redirect HTTPS.
# ============================================================

DirectoryIndex index.html

# ---- Halaman error branded ----
ErrorDocument 404 /404.html

# ---- Kompresi GZIP (hemat bandwidth ±70%) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# ---- Cache browser ----
# HTML selalu revalidasi (konten terbaru begitu upload ulang),
# aset ber-hash (_next/) cache permanen.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ---- Header cache tambahan (fallback tanpa mod_expires) ----
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- HTTPS otomatis (AKTIFKAN setelah SSL jalan) ----
# Buka cPanel → SSL/TLS Status → Run AutoSSL dulu, lalu hapus tanda #
# pada 4 baris di bawah ini.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---- Blokir akses file sensitif ----
<FilesMatch "^\.(env|git|pack-tmp|api-static-hold)">
  Require all denied
</FilesMatch>
<Files "pack-info.json">
  # manifest paket — boleh dilihat publik (tanpa rahasia)
</Files>

# ============================================================
# SECURITY HEADERS — ROADMAP-99 langkah 69 (v1.21.0 "Benteng Digital")
# Jalur hosting statis (Apache/LiteSpeed). Jalur Node standalone
# memakai header yang sama via next.config.ts → headers() —
# ubah KEDUANYA bila daftar origin integrasi berubah.
# ============================================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=(), interest-cohort=()"
  # Aktifkan setelah SSL jalan (AutoSSL); browser mengabaikan ini di http.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # CSP sitewide — GA4/Clarity/Sentry/Midtrans Snap (semuanya env-gated di kode).
  # Untuk rollout aman, ganti nama header menjadi
  # Content-Security-Policy-Report-Only dulu, pantau laporan, lalu enforce.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://app.midtrans.com https://app.sandbox.midtrans.com https://*.sentry.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.clarity.ms https://*.ingest.sentry.io https://*.sentry.io; frame-src 'self' https://app.midtrans.com https://app.sandbox.midtrans.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
